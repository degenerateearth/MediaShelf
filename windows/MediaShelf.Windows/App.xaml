<Application x:Class="MediaShelf.Windows.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="BackgroundBrush" Color="#090B10"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#151922"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#45C9BD"/>
    <Style TargetType="Window"><Setter Property="Background" Value="{StaticResource BackgroundBrush}"/><Setter Property="Foreground" Value="#F4F4F5"/><Setter Property="FontFamily" Value="Segoe UI"/></Style>
    <Style TargetType="Button"><Setter Property="Padding" Value="12,7"/><Setter Property="Margin" Value="4"/><Setter Property="Background" Value="#252B37"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="1"/><Setter Property="BorderBrush" Value="#343942"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#38434C"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentBrush}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="TextBox"><Setter Property="Padding" Value="10,7"/><Setter Property="Background" Value="#1D222C"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#363E4D"/></Style>
    <Style TargetType="ComboBox"><Setter Property="Padding" Value="8,5"/><Setter Property="Background" Value="#1D222C"/><Setter Property="Foreground" Value="#151922"/></Style>
    <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="#151922"/></Style>
  </Application.Resources>
</Application>
