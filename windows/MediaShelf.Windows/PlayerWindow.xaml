<Window x:Class="MediaShelf.Windows.PlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="MediaShelf Player" Width="1100" Height="700" WindowStartupLocation="CenterOwner" Background="Black" KeyDown="Window_KeyDown">
  <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <vlc:VideoView x:Name="Video" Grid.Row="0"/>
    <Grid Grid.Row="1" Background="#E6101115" Margin="0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Button x:Name="PlayPauseButton" Content="Pause" Click="PlayPause_Click" Margin="10"/>
      <Slider x:Name="Timeline" Grid.Column="1" Minimum="0" Maximum="1" Margin="10" VerticalAlignment="Center" PreviewMouseDown="Timeline_Down" PreviewMouseUp="Timeline_Up"/>
      <TextBlock x:Name="TimeText" Grid.Column="2" VerticalAlignment="Center" Margin="10" Foreground="White"/>
    </Grid>
  </Grid>
</Window>
