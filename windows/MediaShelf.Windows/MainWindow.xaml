<Window Style="{StaticResource {x:Type Window}}" x:Class="MediaShelf.Windows.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="MediaShelf" Width="1280" Height="800" MinWidth="900" MinHeight="600" WindowStartupLocation="CenterScreen" PreviewKeyDown="Window_KeyDown">
 <Window.Resources>
  <DataTemplate x:Key="PosterCard">
   <StackPanel Width="164" Margin="0,0,16,20">
    <Border CornerRadius="9" Background="#202731" Height="238" ClipToBounds="True">
     <Grid>
      <StackPanel VerticalAlignment="Center" Margin="16"><TextBlock Text="MEDIASHELF" Foreground="{StaticResource AccentBrush}" FontSize="11"/><TextBlock Text="{Binding DisplayTitle}" TextWrapping="Wrap" FontSize="21" FontWeight="SemiBold" Margin="0,12,0,0"/></StackPanel>
      <Image Source="{Binding ResolvedPosterPath}" Stretch="UniformToFill"/>
      <ProgressBar Value="{Binding ProgressPercent, Mode=OneWay}" Maximum="100" Height="4" Margin="8" VerticalAlignment="Bottom" Foreground="{StaticResource AccentBrush}" Background="#50343A40" BorderThickness="0"/>
     </Grid>
    </Border>
    <TextBlock Text="{Binding DisplayTitle}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" FontSize="14" Margin="0,8,0,4"/>
    <TextBlock Text="{Binding CardSubtitle}" Foreground="#AAB1BE" FontSize="11"/>
    <TextBlock Text="{Binding ProgressLabel}" Foreground="{StaticResource AccentBrush}" FontSize="11" Margin="0,3,0,0"/>
   </StackPanel>
  </DataTemplate>
  <Style TargetType="ListViewItem">
   <Setter Property="Foreground" Value="White"/><Setter Property="Padding" Value="5"/><Setter Property="Margin" Value="0,0,4,0"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListViewItem"><Border x:Name="FocusBorder" BorderThickness="2" BorderBrush="Transparent" CornerRadius="10" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="FocusBorder" Property="Background" Value="#152F363D"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="FocusBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="FocusBorder" Property="BorderBrush" Value="White"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="*"/><RowDefinition Height="30"/></Grid.RowDefinitions>
  <Border Background="#1C1F25" Padding="16,8">
   <DockPanel><Button Content="☰" Click="Sidebar_Click" DockPanel.Dock="Left" ToolTip="Show library navigation" AutomationProperties.Name="Toggle library navigation"/>
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Refresh" Click="Refresh_Click"/><ComboBox x:Name="SortBox" Width="150" SelectionChanged="Filters_Changed" SelectedIndex="0" VerticalAlignment="Center"><ComboBoxItem>Title</ComboBoxItem><ComboBoxItem>Recently Added</ComboBoxItem><ComboBoxItem>Recently Watched</ComboBoxItem><ComboBoxItem>Year</ComboBoxItem></ComboBox></StackPanel>
    <TextBlock Text="MediaShelf" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" Margin="18,0"/>
   </DockPanel>
  </Border>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border x:Name="Sidebar" Width="210" Background="#1C1F25" Padding="18,26" Visibility="Collapsed">
    <StackPanel><TextBlock Text="MEDIA" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="Bold"/><TextBlock Text="My Library" FontSize="21" FontWeight="SemiBold" Margin="0,5,0,26"/>
     <TextBlock Text="Browse" Foreground="#AAB1BE" Margin="0,0,0,8"/>
     <ComboBox x:Name="FilterBox" SelectionChanged="Filters_Changed" SelectedIndex="0"><ComboBoxItem>All</ComboBoxItem><ComboBoxItem>Movies</ComboBoxItem><ComboBoxItem>TV Shows</ComboBoxItem><ComboBoxItem>Watched</ComboBoxItem><ComboBoxItem>Unwatched</ComboBoxItem><ComboBoxItem>Favorites</ComboBoxItem></ComboBox>
     <TextBlock Text="Library folders" Foreground="#AAB1BE" Margin="0,30,0,8"/><Button Content="+  Add folder" Click="AddFolder_Click" HorizontalContentAlignment="Left"/>
     <Button Content="▧  Get Missing Artwork" Click="GetMissingArtwork_Click" HorizontalContentAlignment="Left"/>
    </StackPanel>
   </Border>
   <ScrollViewer x:Name="BrowseContent" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel>
     <Grid x:Name="Hero" Height="340" Background="#18232A">
      <Image x:Name="HeroImage" Stretch="UniformToFill"/>
      <Rectangle><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#FF090B10" Offset="0"/><GradientStop Color="#D0090B10" Offset="0.45"/><GradientStop Color="#20090B10" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
      <Rectangle><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#00090B10" Offset="0.5"/><GradientStop Color="#FF090B10" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
      <StackPanel Margin="32" VerticalAlignment="Center" MaxWidth="570" HorizontalAlignment="Left"><TextBlock Text="YOUR LIBRARY, FRONT AND CENTER" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="Bold"/>
       <TextBlock x:Name="HeroTitle" Text="Your next movie night starts here." FontSize="36" FontWeight="Bold" TextWrapping="Wrap" Margin="0,12,0,10"/>
       <TextBlock x:Name="HeroSummary" Text="Add a folder to bring your movies and shows together." TextWrapping="Wrap" Foreground="#CCD0D6" MaxHeight="64" FontSize="14"/>
       <StackPanel Orientation="Horizontal" Margin="0,16,0,0"><Button x:Name="HeroPlay" Content="▶  Play" Click="HeroPlay_Click" Background="#F4F4F5" Foreground="#111419"/><Button x:Name="HeroDetails" Content="ⓘ  Details" Click="HeroDetails_Click"/><Button x:Name="HeroAdd" Content="+  Add folder" Click="AddFolder_Click"/></StackPanel>
      </StackPanel>
     </Grid>
     <StackPanel Margin="28,8,22,24">
      <Grid Margin="0,0,0,22"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="280"/></Grid.ColumnDefinitions><TextBlock x:Name="BrowseHeading" Text="My Library" FontSize="24" FontWeight="SemiBold"/><TextBox x:Name="SearchBox" Grid.Column="1" TextChanged="Filters_Changed" ToolTip="Search title, episode, genre, or year" AutomationProperties.Name="Search library"/></Grid>
      <StackPanel x:Name="ContinueSection"><TextBlock Text="Continue Watching" FontSize="23" FontWeight="SemiBold" Margin="5,0,0,16"/>
       <ListView x:Name="ContinueList" ItemTemplate="{StaticResource PosterCard}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled" SelectionChanged="ContinueList_SelectionChanged" MouseDoubleClick="Card_Open"><ListView.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListView.ItemsPanel></ListView>
      </StackPanel>
      <TextBlock x:Name="EmptyMessage" Text="No titles found. Try another search or add a media folder." Foreground="#AAB1BE" Margin="5,18" Visibility="Collapsed"/>
      <ListView x:Name="LibraryList" Foreground="White" ItemTemplate="{StaticResource PosterCard}" Background="Transparent" BorderThickness="0" SelectionChanged="LibraryList_SelectionChanged" MouseDoubleClick="Card_Open" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
       <ListView.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListView.ItemsPanel>
       <ListView.GroupStyle><GroupStyle><GroupStyle.HeaderTemplate><DataTemplate><TextBlock Text="{Binding Name}" Foreground="White" FontSize="23" FontWeight="SemiBold" Margin="5,16,0,16"/></DataTemplate></GroupStyle.HeaderTemplate><GroupStyle.Panel><ItemsPanelTemplate><StackPanel/></ItemsPanelTemplate></GroupStyle.Panel></GroupStyle></ListView.GroupStyle>
      </ListView>
     </StackPanel>
    </StackPanel>
   </ScrollViewer>
   <Border x:Name="DetailPanel" Grid.ColumnSpan="2" Background="#090B10" Padding="32" Visibility="Collapsed">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Button Content="←  Back to library" Click="CloseDetails_Click" HorizontalAlignment="Left" Margin="0,0,0,20"/>
     <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Background="#202731" CornerRadius="10" Height="350" VerticalAlignment="Top"><Image x:Name="PosterImage" Stretch="UniformToFill"/></Border>
      <StackPanel Grid.Column="1" Margin="32,0,0,0"><TextBlock x:Name="DetailTitle" FontSize="34" FontWeight="Bold" TextWrapping="Wrap"/><TextBlock x:Name="DetailMeta" Foreground="{StaticResource AccentBrush}" Margin="0,10,0,18"/><TextBlock x:Name="DetailSummary" TextWrapping="Wrap" LineHeight="23" Foreground="#D5D8DE"/>
       <StackPanel Orientation="Horizontal" Margin="0,18,0,12"><Button x:Name="PlayButton" Content="Play" Click="Play_Click"/><Button x:Name="FavoriteButton" Content="Favorite" Click="Favorite_Click"/><Button x:Name="RestartButton" Content="Restart" Click="Restart_Click"/></StackPanel>
       <TextBlock x:Name="EpisodesHeading" Text="Episodes" FontSize="23" FontWeight="SemiBold" Margin="0,14,0,12"/>
       <ComboBox x:Name="SeasonBox" Width="170" HorizontalAlignment="Left" SelectionChanged="Season_Changed" Margin="4,0,0,12" AutomationProperties.Name="Season"/>
       <ListBox x:Name="EpisodesList" Background="Transparent" Foreground="White" BorderThickness="0" SelectionChanged="Episode_Changed" MouseDoubleClick="Play_Click" HorizontalContentAlignment="Stretch"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="10"><TextBlock Text="{Binding EpisodeLabel}" TextWrapping="Wrap" FontSize="15"/><TextBlock Text="{Binding ProgressLabel}" Foreground="{StaticResource AccentBrush}" Margin="0,5,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
      </StackPanel>
     </Grid></ScrollViewer>
    </Grid>
   </Border>
  </Grid>
  <TextBlock x:Name="StatusText" Grid.Row="2" Foreground="#9BA3B2" Margin="24,4" TextTrimming="CharacterEllipsis" FontSize="11"/>
 </Grid>
</Window>

